{
  "name": "sentinel6",
  "displayName": "Sentinel6",
  "version": "0.3.0",
  "description": "Local security scanners with explicit coverage reporting",
  "publisher": "sentinel6-local",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0",
    "node": "^20.9.0 || ^22.11.0 || ^24.0.0"
  },
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "scan": "node scripts/scan.js",
    "check": "node scripts/check.js",
    "threats": "node scripts/threat-monitor.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "sentinel6.scan",
        "title": "Sentinel6: Scan Project"
      },
      {
        "command": "sentinel6.cancel",
        "title": "Sentinel6: Cancel Scan"
      },
      {
        "command": "sentinel6.status",
        "title": "Sentinel6: Scanner Status / Installation"
      },
      {
        "command": "sentinel6.results",
        "title": "Sentinel6: Open Results"
      },
      {"command":"sentinel6.threatFeed","title":"Sentinel6: Open Threat Feed"},
      {"command":"sentinel6.threatRefresh","title":"Sentinel6: Refresh Threat Intelligence"},
      {"command":"sentinel6.threatCancel","title":"Sentinel6: Cancel Threat Collection"},
      {"command":"sentinel6.threatOpen","title":"Sentinel6: View Threat Evidence"},
      {"command":"sentinel6.threatSource","title":"Sentinel6: View Threat Source Status"},
      {"command":"sentinel6.threatClear","title":"Sentinel6: Delete Local Threat Data"},
      {"command":"sentinel6.projectAnalyze","title":"Sentinel6: Analyze Current Project"},
      {"command":"sentinel6.projectReassess","title":"Sentinel6: Reassess Project"},
      {"command":"sentinel6.projectCancel","title":"Sentinel6: Cancel Project Analysis"},
      {"command":"sentinel6.projectImpact","title":"Sentinel6: Check Project Impact"},
      {"command":"sentinel6.projectMarkdown","title":"Sentinel6: Open Project Impact Markdown"},
      {"command":"sentinel6.projectRelated","title":"Sentinel6: View Related Vulnerabilities"},
      {"command":"sentinel6.projectHistory","title":"Sentinel6: View Impact History"},
      {"command":"sentinel6.projectEvidence","title":"Sentinel6: View Project Evidence"},
      {"command":"sentinel6.projectOpenDependency","title":"Sentinel6: Open Dependency File"}
    ],
    "configuration": {
      "title": "Sentinel6",
      "properties": {
        "sentinel6.timeoutSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 5,
          "maximum": 600,
          "description": "Time limit for each scanner"
        },
        "sentinel6.executables": {
          "type": "object",
          "default": {},
          "description": "Trusted absolute executable paths keyed by semgrep, osv, gitleaks, trivy. No shell commands."
        },
        "sentinel6.caches": {
          "type": "object",
          "default": {},
          "description": "User-level absolute offline cache paths keyed by osv and trivy. No automatic downloads."
        },
        "sentinel6.threatMonitoring.enabled":{"type":"boolean","default":true,"scope":"application","description":"Collect public threat metadata once per 24 hours while VS Code is open. No source code or package list upload. Stops when VS Code closes."},
        "sentinel6.threatMonitoring.ecosystems":{"type":"array","items":{"type":"string","enum":["npm","PyPI","Go","Maven"]},"default":["npm","PyPI"],"minItems":1,"maxItems":4,"uniqueItems":true,"scope":"application","description":"Public OSV feeds to monitor; independent of your project. Reload window after changing."},
        "sentinel6.threatMonitoring.retentionDays":{"type":"integer","default":90,"minimum":7,"maximum":365,"scope":"application","description":"Retain unobserved advisories and history for this many days. Reload window after changing."},
        "sentinel6.projectAnalysis.enabled":{"type":"boolean","default":false,"scope":"application","description":"Opt in to local npm/PyPI dependency inventory and cached advisory matching in trusted open workspaces. No installs, source edits or project uploads. Stores dependency evidence locally; runtime conditions remain unverified."}
      }
    },
    "viewsContainers":{"activitybar":[{"id":"sentinel6","title":"Sentinel6","icon":"resources/sentinel6.svg"}]},
    "views":{"sentinel6":[{"id":"sentinel6ThreatFeed","name":"Threat Feed","type":"tree"}]},
    "menus":{"view/title":[{"command":"sentinel6.threatRefresh","when":"view == sentinel6ThreatFeed","group":"navigation"},{"command":"sentinel6.threatCancel","when":"view == sentinel6ThreatFeed","group":"navigation"}]}
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "dependencies": {
    "@renovatebot/pep440": "4.2.4",
    "semver": "7.8.5",
    "sql.js": "1.15.2"
  }
}
